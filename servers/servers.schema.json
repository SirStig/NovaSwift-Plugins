{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NovaSwift public server directory",
  "type": "object",
  "required": [
    "version",
    "servers"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "host",
          "port",
          "region",
          "description",
          "owner",
          "rules",
          "maxPlayers",
          "added"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "description": "DNS name or public IP. Not a private/LAN address."
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "UDP game port (default 53735). Status queries go to 53736 for the default port, otherwise port + 1."
          },
          "region": {
            "enum": [
              "na-east",
              "na-west",
              "sa",
              "eu",
              "af",
              "me",
              "as",
              "oc",
              "global"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 300
          },
          "owner": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "contact": {
                "type": "string",
                "maxLength": 200,
                "description": "Discord handle/invite, GitHub user, or email. Optional but recommended."
              }
            }
          },
          "rules": {
            "enum": [
              "safe",
              "full",
              "custom"
            ]
          },
          "plugins": {
            "type": "array",
            "description": "Plug-ins every player must have enabled. Ids match NovaSwift-Plugins catalog.json where possible.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "contentHash"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "contentHash": {
                  "type": "string",
                  "description": "contentHash from the server's `--public` output / net_ready_manifest()."
                }
              }
            }
          },
          "maxPlayers": {
            "type": "integer",
            "minimum": 2,
            "maximum": 64
          },
          "added": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "website": {
            "type": "string",
            "pattern": "^https://"
          },
          "gameVersion": {
            "type": "string",
            "description": "Optional hint; the live status query is authoritative."
          },
          "totalConversion": {
            "type": "string",
            "description": "Catalog id of the total conversion the server runs, if any."
          },
          "tcAddons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Catalog ids of add-ons enabled for that total conversion, in load order."
          }
        }
      }
    }
  }
}
